{
  "name": "ai-sop-helper",
  "version": "0.1.0",
  "private": true,
  "description": "AI SOP system workspace",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace api-service run start:dev",
    "dev:web": "npm --workspace web run dev",
    "dev:worker": "npm --workspace workflows run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm --workspace api-service run prisma:generate",
    "prisma:migrate": "npm --workspace api-service run prisma:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@sentry/node": "^10.27.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2"
  }
}
