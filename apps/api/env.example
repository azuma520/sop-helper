# Database
# Option 1: Local PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_sop_help?schema=public"

# Option 2: Docker Compose (see docker-compose.yml)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_sop_help_dev?schema=public"

# Option 3: Supabase (recommended for development)
# Get connection string from: Supabase Dashboard → Settings → Database → Connection string (URI)
# Use Connection pooling (port 6543) for better connection management
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# For now, use one of the options above:
DATABASE_URL="postgresql://user:password@localhost:5432/ai_sop_help?schema=public"

# JWT Authentication
JWT_SECRET="change-me-in-production-use-strong-random-secret"
JWT_EXPIRES_IN="24h"

# Server
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="*"

# LLM / AI Services
TAGGING_LLM_PROVIDER="mock"
OPENAI_API_KEY=""

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="ai-sop-api"

